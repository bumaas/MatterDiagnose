{
    "elements": [
        {
            "type": "Label",
            "caption": "This tool checks the most common obstacles when integrating Matter devices (especially Matter over Thread): IPv6, device discovery, border routers and network paths. It also compares the devices paired in Symcon with those actually visible in the network."
        },
        {
            "type": "NumberSpinner",
            "name": "MonitorInterval",
            "caption": "Monitoring interval in minutes (0 = off, default 60)",
            "suffix": "min",
            "minimum": 0
        },
        {
            "type": "Label",
            "caption": "With monitoring switched on, the check repeats in the background and writes its result to the status variables. Devices are not pinged during those runs, so battery-powered Thread devices stay asleep. The variable \"Last changes\" is only written when something actually changed — an event on \"update\" of that variable is the place to hook up a notification.",
            "italic": true
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Start diagnosis",
            "confirm": "The diagnosis takes up to half a minute and only reads from the network. Start now?",
            "onClick": "IPS_RequestAction($id, 'Diagnosis', true);"
        },
        {
            "type": "Label",
            "name": "ProgressText",
            "caption": "",
            "visible": false
        },
        {
            "type": "List",
            "name": "Findings",
            "caption": "Findings",
            "rowCount": 1,
            "add": false,
            "delete": false,
            "columns": [
                {
                    "caption": "Status",
                    "name": "Status",
                    "width": "50px"
                },
                {
                    "caption": "Finding",
                    "name": "Finding",
                    "width": "350px"
                },
                {
                    "caption": "Details",
                    "name": "Details",
                    "width": "450px"
                },
                {
                    "caption": "What to do",
                    "name": "Advice",
                    "width": "auto"
                }
            ],
            "values": []
        },
        {
            "type": "ValidationTextBox",
            "name": "Commands",
            "caption": "Commands to run (administrator rights)",
